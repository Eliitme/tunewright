// Static web app served by Workers static assets (SPA fallback, `_headers` from the build).
// Build with `pnpm build:<env>` first; deploy with `pnpm deploy:<env>` (staging | production).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tunewright-web",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": {
      "name": "tunewright-web-staging",
      "routes": [{ "pattern": "tunewright-staging.serendipity-work.com", "custom_domain": true }]
    },
    "production": {
      "name": "tunewright-web",
      "routes": [{ "pattern": "tunewright.serendipity-work.com", "custom_domain": true }]
    }
  }
}
